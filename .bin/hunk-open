#!/usr/bin/env bash
# Open a Hunk review in a window labelled "hunk" in this Rex session,
# replacing the previous one (and closing the popup we're in, e.g. lazygit's).
# Outside Rex, hunk runs right here.
# In the review, `e` opens the file at that line in the session's nvim-server.
#
#   hunk-open diff [args...]        hunk-open show <ref> [args...]
# Closing the old review sends its unsent notes to the agent (Hunk's agent-send extension).
set -euo pipefail
. "$HOME/.bin/lib/nvim-session.sh"

EDITOR_NVR="$HOME/.bin/lib/nvr-as-nvim/nvim"

# Inside the review window: run hunk; the window closes when it exits.
if [ "${1:-}" = --run ]; then
  shift
  EDITOR="$EDITOR_NVR" exec hunk "$@"
fi

[ $# -gt 0 ] || set -- diff

sess=$(nvs_session 2>/dev/null) || { EDITOR="$EDITOR_NVR" exec hunk "$@"; }
for win in $(rex window ls -s "$sess" --json | jq -r '.windows[] | select(.label == "hunk") | .window_id'); do
  rex window close -s "$sess" "$win" >/dev/null 2>&1 || true
done
nvs_rex_window hunk "$PWD" true "$HOME/.bin/hunk-open" --run "$@" >/dev/null ||
  nvs_die "hunk-open: couldn't open a window"
nvs_close_popup
