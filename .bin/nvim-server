#!/usr/bin/env bash
# Launch nvim with a socket for this Rex session (lib/nvim-session.sh), and
# record its block so pickers can bring it into view. Outside Rex, or if a
# live server already owns the session socket, launch plain nvim.
set -e
. "$HOME/.bin/lib/nvim-session.sh"

sock=$(nvs_sock 2>/dev/null) || exec nvim "$@"
mkdir -p "$NVS_DIR"

if nvs_alive "$sock"; then
  echo "nvim-server: session socket already bound at $sock — launching detached" >&2
  exec nvim "$@"
fi

echo "${REX_BLOCK:-}" > "$(nvs_state block)"
rm -f "$sock"
exec nvim --listen "$sock" "$@"
