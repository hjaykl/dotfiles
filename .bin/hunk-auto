#!/usr/bin/env bash
# Open a Hunk review tab by itself when an agent's turn ends with a changed
# worktree diff. Off by default, per terminal:
#
#   hunk-auto            toggle        hunk-auto on | off | status
#   hunk-auto --hook     what Claude Code's Stop hook runs (~/.claude/settings.json)
#
# On = the hc label hunk.auto=1 on this terminal. The hook does nothing when
# it is off, when the diff is the same as last time, or when a "hunk" tab is
# already open in this space (your review in progress is left alone).
set -uo pipefail
. "$HOME/.bin/lib/nvim-session.sh"

me="${HC_TERMINAL_ID:-}"
state="${XDG_RUNTIME_DIR:-/tmp}/hunk-notes"

fingerprint() { # of the repo at $1; empty when it is not one
  git -C "$1" rev-parse --show-toplevel >/dev/null 2>&1 || return 0
  { git -C "$1" status --porcelain=v1; git -C "$1" diff HEAD 2>/dev/null; } | shasum | cut -d' ' -f1
}
is_on() { [ "$(hc get "$me" --json 2>/dev/null | jq -r '.labels["hunk.auto"] // empty')" = 1 ]; }

if [ "${1:-}" = --hook ]; then
  input=$(cat)
  [ -n "$me" ] && is_on || exit 0
  cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
  [ -n "$cwd" ] || cwd="$PWD"
  top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || exit 0
  fp=$(fingerprint "$top")
  [ -n "$fp" ] && [ "$fp" != "$(cat "$state/$me.fp" 2>/dev/null)" ] || exit 0
  [ -n "$(git -C "$top" status --porcelain=v1)" ] || { echo "$fp" > "$state/$me.fp"; exit 0; }
  key=$(nvs_key) || exit 0
  open=$(herdr-app ls 2>/dev/null | jq -r --arg s "${key#herdr-}" '.spaces[] | select(.id == $s) | .tabs[] | select(.name == "hunk") | .id' 2>/dev/null)
  [ -z "$open" ] || exit 0
  echo "$fp" > "$state/$me.fp"
  (cd "$top" && "$HOME/.bin/hunk-open" diff) >/dev/null 2>&1 </dev/null &
  exit 0
fi

[ -n "$me" ] || { echo "hunk-auto: not in a Herdr terminal" >&2; exit 1; }
mode="${1:-toggle}"
if [ "$mode" = toggle ]; then if is_on; then mode=off; else mode=on; fi; fi
case "$mode" in
  status) if is_on; then echo "Auto Hunk review: on ($me)"; else echo "Auto Hunk review: off ($me)"; fi ;;
  off) hc label "$me" hunk.auto= >/dev/null; echo "Auto Hunk review: off ($me)" ;;
  on)
    mkdir -p -m 700 "$state"
    fingerprint "$PWD" > "$state/$me.fp"   # only changes from now on open a review
    hc label "$me" hunk.auto=1 >/dev/null
    echo "Auto Hunk review: on ($me). Opens after a turn that changes the diff."
    ;;
  *) echo "usage: hunk-auto [on|off|status|--hook]" >&2; exit 1 ;;
esac
