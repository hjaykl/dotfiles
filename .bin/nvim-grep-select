#!/usr/bin/env bash
# Dispatch nvim-grep selection:
#   single arg  → open that file at line (via nvr)
#   multiple    → populate nvim quickfix list, jump to first, :copen
set -e
. "$HOME/.bin/lib/nvim-session.sh"

[ $# -eq 0 ] && exit 0

if [ $# -eq 1 ]; then
  file="${1%%:*}"
  rest="${1#*:}"
  line="${rest%%:*}"
  case "$file" in /*) ;; *) file="$PWD/$file" ;; esac
  exec nvr "+$line" "$file"
fi

sock=$(nvs_require)

tmpfile=$(mktemp -t nvimgrep.XXXXXX)
for sel in "$@"; do
  file="${sel%%:*}"
  rest="${sel#*:}"
  case "$file" in
    /*) absfile="$file" ;;
    *) absfile="$PWD/$file" ;;
  esac
  printf '%s:%s\n' "$absfile" "$rest" >> "$tmpfile"
done

nvs_focus
nvim --server "$sock" --remote-send "<C-\\><C-N>:silent! cfile $tmpfile<CR>:copen<CR>"

( sleep 10 && rm -f "$tmpfile" ) </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true
