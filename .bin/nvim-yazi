#!/usr/bin/env bash
# yazi that reveals the file open in the session's nvim when started from the
# nvim block, otherwise opens at CWD. Files opened in yazi go to nvim (nvr).
#
#   nvim-yazi CWD [CMD]
# CMD is the focused block's command; "nvim" turns on reveal.
set -e
. "$HOME/.bin/lib/nvim-session.sh"

cwd="${1:-$PWD}"
cmd="${2:-}"
target="$cwd"

if [ "$cmd" = "nvim" ]; then
  sock=$(nvs_sock 2>/dev/null || true)
  if [ -n "$sock" ] && nvs_alive "$sock"; then
    file=$(nvim --server "$sock" --remote-expr "expand('%:p')" </dev/null 2>/dev/null || true)
    [ -n "$file" ] && [ -e "$file" ] && target="$file"
  fi
fi

cd "$cwd"
exec yazi "$target"
