#!/usr/bin/env bash
# Send --remote args to the session's nvim-server socket (tmux or Herdr).
# Supports a leading +LINE to jump to a specific line after opening.
set -e
. "$HOME/.bin/lib/nvim-session.sh"

sock=$(nvs_require)

line=""
files=()
for arg in "$@"; do
  case "$arg" in
    +[0-9]*) line="${arg#+}" ;;
    /*)      files+=("$arg") ;;
    *)       files+=("$PWD/$arg") ;;
  esac
done

nvs_focus

if [ "${#files[@]}" -gt 1 ]; then
  # Multiple files → populate :args list, current window shows first.
  args_line=""
  for f in "${files[@]}"; do
    esc=$(printf '%s' "$f" | sed -e 's/\\/\\\\/g' -e 's/ /\\ /g' -e 's/|/\\|/g' -e 's/#/\\#/g' -e 's/%/\\%/g')
    args_line+=" $esc"
  done
  nvim --server "$sock" --remote-send "<C-\\><C-N>:args${args_line}<CR>"
elif [ "${#files[@]}" -eq 1 ]; then
  nvim --server "$sock" --remote "${files[@]}"
fi

if [ -n "$line" ]; then
  nvim --server "$sock" --remote-send "<C-\\><C-N>:${line}<CR>"
fi
