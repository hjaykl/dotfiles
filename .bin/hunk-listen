#!/usr/bin/env bash
# Make this block's agent the one that gets Hunk review notes in this Rex
# session (Hunk's agent-send extension, ~/.config/hunk/extensions). One
# listener per session: turning it on here turns it off elsewhere. Without a
# listener, Hunk sends to the session's only agent.
#
#   hunk-listen            toggle        hunk-listen on | off | status
#
# The listener is kept in <dir>/rex-<session id>.listener (dir:
# $XDG_RUNTIME_DIR or /tmp, /hunk-notes): line 1 the block, line 2 the label
# its tab had. The tab shows it: " ◉ hunk" is added to its label.
#
# Turning it on also hands over reviews that could not be delivered earlier:
# printed (for /hunk-listen in the agent), or with HUNK_LISTEN_DELIVER=1
# (the cmd+shift+h key) pasted into the agent.
set -euo pipefail
. "$HOME/.bin/lib/nvim-session.sh"

me="${REX_BLOCK:-}"
[ -n "$me" ] || { echo "hunk-listen: no Rex block" >&2; exit 1; }
key=$(nvs_key) || { echo "hunk-listen: no Rex session" >&2; exit 1; }
sess="session:${key#rex-}"
dir="${XDG_RUNTIME_DIR:-/tmp}/hunk-notes"
state="$dir/$key.listener"
MARK=" ◉ hunk"

window_of() {
  rex api call session.list_blocks "$(jq -cn --arg s "$sess" '{session_id: $s}')" |
    jq -r --arg b "$1" '.blocks[] | select(.block_id == $b) | .window_id // empty'
}
window_label() {
  rex window ls -s "$sess" --json | jq -r --arg w "$1" '.windows[] | select(.window_id == $w) | .label'
}

mark() { # $1: block; prints the label its tab had
  local win label
  win=$(window_of "$1"); [ -n "$win" ] || return 0
  label=$(window_label "$win")
  case "$label" in *"$MARK") label="${label%"$MARK"}" ;; *) rex window rename -s "$sess" "$win" "$label$MARK" >/dev/null 2>&1 || true ;; esac
  printf '%s' "$label"
}
unmark() { # $1: block, $2: the label to put back
  local win label
  win=$(window_of "$1"); [ -n "$win" ] || return 0
  label=$(window_label "$win")
  case "$label" in *"$MARK") rex window rename -s "$sess" "$win" "${2:-${label%"$MARK"}}" >/dev/null 2>&1 || true ;; esac
}

current=$(sed -n 1p "$state" 2>/dev/null || true)
old_label=$(sed -n 2p "$state" 2>/dev/null || true)

mode="${1:-toggle}"
if [ "$mode" = toggle ]; then
  if [ "$current" = "$me" ]; then mode=off; else mode=on; fi
fi

case "$mode" in
  status)
    if [ -n "$current" ]; then echo "Hunk reviews in this session go to: $current"
    else echo "No listener: Hunk reviews go to the session's only agent"; fi
    ;;
  off)
    if [ "$current" = "$me" ]; then
      unmark "$me" "$old_label"
      rm -f "$state"
    fi
    echo "Stopped listening for Hunk reviews (${me: -6})"
    ;;
  on)
    "$HOME/.bin/rex-agent" is-agent "$me" || { echo "hunk-listen: no coding agent in this block" >&2; exit 1; }
    [ -n "$current" ] && [ "$current" != "$me" ] && unmark "$current" "$old_label"
    mkdir -p "$dir"
    label=$(mark "$me")
    printf '%s\n%s\n' "$me" "$label" > "$state"
    echo "Listening for Hunk reviews (${me: -6})"
    for f in "$dir/$key.pending"/*.txt; do
      [ -s "$f" ] || continue
      if [ "${HUNK_LISTEN_DELIVER:-}" = 1 ]; then
        ( "$HOME/.bin/rex-agent" send "$me" "$f" && rm -f "$f" ) </dev/null >/dev/null 2>&1 &
      else
        printf '\nUndelivered review:\n\n'
        cat "$f"
        rm -f "$f"
      fi
    done
    ;;
  *) echo "usage: hunk-listen [on|off|status]" >&2; exit 1 ;;
esac
