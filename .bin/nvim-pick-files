#!/usr/bin/env bash
# fzf file picker → open in the session's nvim-server via nvr.
# Tab to multi-select, Enter to confirm. Always starts with an empty query.
set -e

sels=$(fd --type f --hidden --no-ignore-vcs --exclude .git --exclude node_modules 2>/dev/null | fzf --multi) || exit 0
[ -z "$sels" ] && exit 0
files=()
while IFS= read -r s; do
  [ -n "$s" ] && files+=("$PWD/$s")
done <<< "$sels"
exec nvr "${files[@]}"
