#!/usr/bin/env bash
# wt-ui: the worktree popup (cmd+; in Rex, .config/rex/init.lua).
#
# Lists the repos open in Rex by worktree (lib/wt-list.lua): ○ no session,
# ● a session; with an agent in it (OSC 7501 status, as Claude Code reports),
# its most urgent state: ◆ needs you, ✗ error, ✓ done, ◐ working, ● idle. The
# agents themselves are listed under their worktree (t hides/shows them, and
# the choice is kept). The list refreshes every 2 s (ticker). A repo's row
# stands for its main checkout.
#
# It opens browsing, with no search box, so plain letters are commands:
#
#   j/k      move (also ctrl-n/ctrl-p, arrows)
#   enter    go to the worktree's session (made first if it has none); on an
#            agent's row, to that agent's pane
#   n        new worktree in the selected row's repo: type its branch, enter
#   a        the same, with a claude tab
#   x        remove the worktree and close its sessions (branch kept)
#   c        close the session only (worktree kept)
#   p        prune: remove the listed repos' merged, gone and unused
#            worktrees (wt merged; unused ones only without a session)
#   /        search (enter on no match creates the query in this repo)
#   t        show/hide the agents
#   o        all repos: add the ones in ~/.config/wt/roots folders, open or
#            not (and back to only the open ones); kept, like t
#   r        reload        q, esc   close (esc in a prompt: back)
#
# Creating and removing is done by `wt`; this is only the picker around it.

set -uo pipefail

LIST="$HOME/.bin/lib/wt-list.lua"
SELF="$HOME/.bin/wt-ui"
# The command keys, typed as text while a prompt is shown.
LETTERS='j,k,n,a,x,c,p,t,o,r,q,/'
# Kept between popups: present when the agents are hidden (t), and when all
# repos are listed (o).
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/wt-ui"
HIDE_AGENTS="$STATE/hide-agents"
SHOW_ALL="$STATE/show-all"

# The key hints; o says what it switches to.
keys() {
  local o="all repos"
  [ -e "$SHOW_ALL" ] && o="open repos"
  printf '↵ go · n new · a new + claude · x remove · c close session · p prune · t agents · o %s · / search · r reload · q quit' "$o"
}

note_file() { echo "${WT_UI_NOTE_FILE:-/dev/null}"; }
note() { printf '%s\n' "$*" > "$(note_file)"; }

tilde() { local p=$1; [ "${p#"$HOME"}" != "$p" ] && p="~${p#"$HOME"}"; printf '%s' "$p"; }

# The list (lib/wt-list.lua), also kept for the preview, which runs on every
# cursor move: reading this beats asking Rex again.
CACHE() { echo "${WT_UI_NOTE_FILE:-/nonexistent}.json"; }
list_data() { # [all=true]
  local out
  out=$(rex do "$LIST" ${REX_BLOCK:+skip="$REX_BLOCK"} "$@" --json) || return 1
  [ -n "${WT_UI_NOTE_FILE:-}" ] && printf '%s' "$out" > "$(CACHE).tmp" && mv "$(CACHE).tmp" "$(CACHE)"
  printf '%s' "$out"
}
cached_list() {
  cat "$(CACHE)" 2>/dev/null || rex do "$LIST" --json 2>/dev/null
}

# Rows: kind (repo, wt, agent), repo main, path, session id, agent pane,
# then what fzf shows.
rows() {
  local show=true
  [ -e "$HIDE_AGENTS" ] && show=false
  local all=()
  [ -e "$SHOW_ALL" ] && all=(all=true)
  list_data "${all[@]+"${all[@]}"}" | jq -r --arg home "$HOME" --argjson show "$show" '
    def arr: if type == "array" then . else [] end;
    def tilde: if startswith($home) then "~" + .[($home | length):] else . end;
    def pad($n): . + (if length < $n then " " * ($n - length) else "" end);
    def cut($n): if length > $n then .[0:$n - 1] + "…" else . end;
    def urgency: {blocked: 5, error: 4, done: 3, working: 2, idle: 1}[. // ""] // 0;
    def c($code): "\u001b[\($code)m\(.)\u001b[0m";
    # The mark, the word and its colour for a state.
    def look($st; $kind):
      if $st == "blocked" then
        ["◆", "needs you" + ({permission: ": approve", question: ": answer", auth: ": log in"}[$kind // ""] // ""), "1;33"]
      elif $st == "error" then ["✗", "error", "31"]
      elif $st == "done" then ["✓", "done", "32"]
      elif $st == "working" then ["◐", "working", "36"]
      elif $st == "idle" then ["●", "idle", "32"]
      else ["●", "", "32"] end;
    # ... for a worktree, from its most urgent session.
    def status($ss):
      if ($ss | length) == 0 then ["○", "", "2"]
      else ($ss[0].state) as $st
        | look($st; $ss[0].agents | arr | map(select(.state == $st)) | .[0].kind)
      end;
    def word($w; $color): $w | pad(18) | c(if $w == "idle" then "2" else $color end);
    # An agent row'"'"'s label: its program'"'"'s mark (Claude Code: ✻ in Claude
    # orange), its name (the conversation'"'"'s, else the tab'"'"'s), and where it is.
    def icon: if .app == "claude-code" then "✻" else "▪" end;
    def label_parts($s): [icon, (.name // .tab | cut(32)), ($s.label + " › " + .tab)];
    def label_len($s): label_parts($s) | "\(.[0]) \(.[1])  \(.[2])" | length;
    .repos | arr | .[] as $r
    | ($r.worktrees | arr
       | map(.sessions = (.sessions | arr | sort_by(-(.state | urgency))))) as $wts
    | ([$wts[] | (.branch | length)] + [8] | max) as $bw
    | ([$wts[] | (.sessions | map(.label) | join(", ") | length)] + [6] | max) as $sw0
    # Agent labels share the branch + sessions columns; widen the sessions
    # column when they need more room, so the state words stay aligned.
    | ([if $show then ($wts[] | .sessions[] as $s | $s.agents | arr | .[] | label_len($s)) else empty end] + [0]
       | max | [., 60] | min) as $aw
    | ([$sw0, $aw + 2 - $bw] | max) as $sw
    | ( ["repo", $r.main, $r.main, ($wts[0].sessions[0].id // ""), "",
          ($r.name | c("1;34")) + "  " + ($r.main | tilde | c("2"))]
      , ($wts[] as $w
         | $w.sessions as $ss
         | ( status($ss) as [$mark, $word, $color]
             | ["wt", $r.main, $w.path, ($ss[0].id // ""), "",
                "  " + ($mark | c($color))
                + " " + ((if $w.branch == "" then "(detached)" else $w.branch end) | pad($bw))
                + "  " + ($ss | map(.label) | join(", ") | pad($sw) | c("33"))
                + "  " + word($word; $color)
                + "  " + (($w.path | tilde) + (if $w.main then "  (main)" else "" end) | c("2"))] )
           , ( if $show then
                 $ss[] as $s | ($s.agents | arr | .[]) as $a
                 | look($a.state; $a.kind) as [$mark, $word, $color]
                 | ["agent", $r.main, $w.path, $s.id, ($a.block_id // ""),
                    "      " + ($mark | c($color))
                    + " " + ($a | label_parts($s) as [$i, $n, $where]
                        | ($i | if . == "✻" then "\u001b[38;2;217;119;87m✻\u001b[0m" else . end)
                          + " " + ($n | c("1"))
                          + "  " + ($where | cut($bw + $sw - 6 - ($n | length)) | pad($bw + $sw - 6 - ($n | length)) | c("2")))
                    + "  " + word($word; $color)
                    + "  " + (($a.msg // $a.title // "") | gsub("\t"; " ") | cut(120) | c("2"))]
               else empty end ) )
      )
    | @tsv'
}

# t, o: flip a kept setting (its file present or not).
toggle() { # FILE
  if [ -e "$1" ]; then
    rm -f "$1"
  else
    mkdir -p "$(dirname "$1")" && touch "$1"
  fi
}

# The header: the keys for the mode (or TEXT), the last note, then a blank
# line before the list.
header() { # [TEXT]
  local msg keys=${1:-$(keys)}
  msg=$(cat "$(note_file)" 2>/dev/null)
  printf '%s\n' "$keys"
  [ -n "$msg" ] && printf '%s\n' "$msg"
  printf ' '
}

preview() { # PATH SID [BLOCK]
  local path=$1 sid=${2:-} block=${3:-} data
  [ -d "$path" ] || { echo "missing: $path"; return; }
  data=$(cached_list)
  if [ -n "$block" ]; then
    preview_agent "$block" <<<"$data"
    echo
  fi
  # One git status for the branch, its upstream, ahead/behind and changes.
  # --no-optional-locks: fzf kills the preview on every cursor move, and a
  # status killed while it held index.lock (to refresh the index) left the
  # lock behind, blocking the next commit.
  local status head branch upstream counts
  status=$(git --no-optional-locks -C "$path" -c color.status=always status --short --branch 2>/dev/null)
  head=$(printf '%s\n' "$status" | head -n 1 | sed 's/\x1b\[[0-9;]*m//g')
  head=${head#\#\# }
  branch=${head%%...*} branch=${branch%% *}
  [ "$branch" = HEAD ] && branch="(detached)"
  printf '\033[1m%s\033[0m  %s\n' "$branch" "$(tilde "$path")"
  if [ "${head#*...}" != "$head" ]; then
    upstream=${head#*...} upstream=${upstream%% *}
    counts=$(printf '%s' "$head" | sed -n 's/.*\[\(.*\)\].*/\1/p')
    printf '%s: %s\n' "$upstream" "${counts:-up to date}"
  else
    echo "no upstream"
  fi
  git -C "$path" log -1 --format='%C(yellow)%h%Creset %s %C(dim)(%cr)%Creset' --color=always 2>/dev/null
  echo
  local changes
  changes=$(printf '%s\n' "$status" | tail -n +2)
  if [ -n "$changes" ]; then
    printf '%s\n' "$changes" | head -n 20
    [ "$(printf '%s\n' "$changes" | wc -l)" -gt 20 ] && echo "…"
  else
    echo "clean"
  fi
  if [ -n "$sid" ]; then
    preview_session "$sid" <<<"$data"
  fi
}

# One agent (on its row), in full. Reads the list on stdin.
preview_agent() { # BLOCK
  jq -r --arg b "$1" '
    def arr: if type == "array" then . else [] end;
    def c($code): "\u001b[\($code)m\(.)\u001b[0m";
    [.repos | arr | .[].worktrees | arr | .[].sessions | arr | .[] as $s
     | $s.agents | arr | .[] | select(.block_id == $b) | . + {session: $s.label}][0] // empty
    | ({blocked: ["◆", "needs you", "1;33"], error: ["✗", "error", "31"], done: ["✓", "done", "32"],
        working: ["◐", "working", "36"], idle: ["●", "idle", "2"]}[.state] // ["●", .state, "2"]) as [$m, $w, $col]
    | "\($m | c($col)) \(if .app == "claude-code" then "\u001b[38;2;217;119;87m✻\u001b[0m " + ("claude" | c("1")) else ((.app // "program") | c("1")) end)  \($w + (if .state == "blocked" and .kind then " (" + .kind + ")" else "" end) | c($col))",
      (if .name then (.name | c("1")) else empty end),
      ("\(.session) › \(.tab)" | c("2")),
      (if (.title // "") != "" then "", .title else empty end),
      (if (.msg // "") != "" then "", .msg else empty end)'
}

# Session SID: its agents (most urgent first) and its tabs. Reads the list on
# stdin.
preview_session() { # SID
  jq -r --arg sid "$1" '
    def arr: if type == "array" then . else [] end;
    def c($code): "\u001b[\($code)m\(.)\u001b[0m";
    [.repos | arr | .[].worktrees | arr | .[].sessions | arr | .[] | select(.id == $sid)][0] // empty
    | ((.agents | arr) as $agents
       | if ($agents | length) == 0 then empty else
           "", ("agents" | c("1")),
           ($agents[] |
             ({blocked: ["◆", "needs you", "1;33"], error: ["✗", "error", "31"], done: ["✓", "done", "32"],
               working: ["◐", "working", "36"], idle: ["●", "idle", "2"]}[.state] // ["●", .state, "2"]) as [$m, $w, $col]
             | (if .state == "blocked" and .kind then $w + " (" + .kind + ")" else $w end) as $w
             | "\($m | c($col)) \($w | c($col))  \(.name // .app // "program") in \(.tab)",
               (if (.msg // "") != "" then "    " + (.msg | c("2")) else empty end))
         end),
      "", ("session " + .label | c("1")),
      (.tabs | arr | .[] | (if .active then "▸ " else "  " end) + .name)'
}

# Refreshes the list every 2 s through fzf's socket, so agent states stay
# current. Stops when a newer ticker has started, and skips a beat while a
# confirmation is drawn (a reload would draw over it). When fzf is gone for
# good it also removes the popup's files: wt-ui hands its process to fzf, so
# nothing else is left to.
ticker() {
  local sock="$WT_UI_NOTE_FILE.sock" me=$$
  mine() { [ "$(cat "$WT_UI_NOTE_FILE.ticker" 2>/dev/null)" = "$me" ]; }
  post() {
    curl -fs --unix-socket "$sock" -XPOST http://localhost \
      -d "reload($SELF rows)+refresh-preview" >/dev/null 2>&1
  }
  echo "$me" > "$WT_UI_NOTE_FILE.ticker"
  while sleep 2; do
    mine || return 0
    [ -e "$WT_UI_NOTE_FILE.busy" ] && continue
    post && continue
    # fzf may be coming back (an error reopens the popup): give it a moment.
    sleep 1
    mine || return 0
    post && continue
    rm -f "$WT_UI_NOTE_FILE" "$WT_UI_NOTE_FILE".{sock,busy,ticker,json,json.tmp}
    return 0
  done
}

# Go to PATH's session (enter), or with BLOCK to that agent's pane. Runs as
# fzf's `become`: on success the popup closes; on failure it says why and
# comes back.
go() { # PATH SID [BLOCK]
  local path=$1 sid=${2:-} block=${3:-}
  if [ -n "$sid" ]; then
    # Focusing the pane also makes its tab the session's active one.
    [ -z "$block" ] || rex api call -s "$sid" session.focus_block \
      "$(jq -nc --arg b "$block" '{block_id: $b}')" >/dev/null 2>&1
    rex do session.select session_id="$sid" >/dev/null 2>&1 && exit 0
    fail "couldn't switch the app to that session (Remote Control off in Rex settings?)"
  fi
  out=$(cd "$path" && wt open "$path" 2>&1) && exit 0
  fail "$out"
}

# New worktree BRANCH in the repo at MAIN (alt-n, alt-a).
new() { # AGENT BRANCH MAIN
  local agent=$1 branch=$2 main=${3:-}
  if [ -z "$main" ]; then
    main=$(git rev-parse --show-toplevel 2>/dev/null) ||
      fail "no repo selected: pick a row of the repo first, then M-n"
  fi
  local args=(new "$branch")
  [ "$agent" = 1 ] && args+=(--agent)
  echo "Creating $branch in $(tilde "$main")…" >&2
  out=$(cd "$main" && wt "${args[@]}" 2>&1) && exit 0
  fail "$out"
}

fail() {
  note "$(printf '\033[31m%s\033[0m' "$*" | tail -n 3)"
  exec "$SELF"
}

# A confirmation, drawn as a solid panel where fzf's was (same inset and
# colours as the picker() fzf options in init.lua): the popup layer's default
# background is see-through, so text must paint its own. Each LINE is
# "STYLE:text" with STYLE b (bold), r (red), d (dim) or - (plain). Returns
# the key pressed.
BG=$'\033[48;2;22;27;34m'
BORDER=$'\033[38;2;72;79;88m'
confirm() { # LINE...
  local size rows cols margin mv mh top left w h r line style text
  size=$(stty size </dev/tty 2>/dev/null) || size="24 80"
  rows=${size% *} cols=${size#* }
  margin=$(printf '%s' "${FZF_DEFAULT_OPTS:-}" | sed -n 's/.*--margin[ =]\([^ ]*\).*/\1/p')
  margin=${margin:-10%,6%}
  mv=${margin%%,*} mh=${margin#*,}
  [ "$mh" = "$margin" ] && mh=$mv
  top=$(( ${mv%\%} * rows / 100 )) left=$(( ${mh%\%} * cols / 100 ))
  w=$(( cols - 2 * left )) h=$(( rows - 2 * top ))
  [ "$w" -ge 20 ] && [ "$h" -ge 6 ] || { top=0 left=0 w=$cols h=$rows; }

  local inner fill
  inner=$(( w - 2 ))
  fill=$(printf '%*s' "$inner" '')
  {
  printf '\033[?25l\033[2J'
  printf '\033[%d;%dH%s%s╭%s╮' $(( top + 1 )) $(( left + 1 )) "$BG" "$BORDER" "${fill// /─}"
  for (( r = 2; r < h; r++ )); do
    printf '\033[%d;%dH%s%s│%s│' $(( top + r )) $(( left + 1 )) "$BG" "$BORDER" "$fill"
  done
  printf '\033[%d;%dH%s%s╰%s╯\033[0m' $(( top + h )) $(( left + 1 )) "$BG" "$BORDER" "${fill// /─}"

  local width=$(( inner - 4 )) row=$(( top + 3 )) last=$(( top + h - 3 ))
  for line in "$@"; do
    [ "$row" -le "$last" ] || break
    style=${line%%:*} text=${line#*:}
    [ "${#text}" -le "$width" ] || text="${text:0:$(( width - 1 ))}…"
    case $style in
      b) text=$'\033[1m'"$text" ;;
      r) text=$'\033[31m'"$text" ;;
      d) text=$'\033[2m'"$text" ;;
    esac
    printf '\033[%d;%dH%s\033[39m%s\033[0m' "$row" $(( left + 4 )) "$BG" "$text"
    row=$(( row + 1 ))
  done
  } >/dev/tty
  local key
  read -r -s -n 1 key </dev/tty
  printf '\033[0m\033[?25h' >/dev/tty
  printf '%s' "$key"
}

# x: confirm, then wt rm. Runs as fzf's `execute`, on the terminal.
rm_worktree() { # KIND MAIN PATH
  local main=$2 path=$3
  if [ "$(cd "$path" 2>/dev/null && pwd -P)" = "$(cd "$main" && pwd -P)" ]; then
    note "$(printf '\033[31mthe main checkout of %s is not a worktree: not removed\033[0m' "$(tilde "$main")")"
    return
  fi
  local force=() status lines=()
  status=$(git --no-optional-locks -C "$path" status --short 2>/dev/null)
  lines+=("b:Remove this worktree?" "-:" "-:$(tilde "$path")" "-:" "d:Its sessions close. The branch stays.")
  if [ -n "$status" ]; then
    lines+=("-:" "r:It has uncommitted changes, which will be lost:")
    while IFS= read -r l; do lines+=("-:  $l"); done < <(printf '%s\n' "$status" | head -n 12)
    force=(--force)
  fi
  lines+=("-:" "b:y remove · any other key: cancel")
  local answer
  touch "$WT_UI_NOTE_FILE.busy"
  answer=$(confirm "${lines[@]}")
  rm -f "$WT_UI_NOTE_FILE.busy"
  if [ "$answer" != y ] && [ "$answer" != Y ]; then
    note "not removed"
    return
  fi
  local out
  if out=$(cd "$main" && wt rm "$path" ${force[@]+"${force[@]}"} 2>&1); then
    note "removed $(tilde "$path")"
  else
    note "$(printf '\033[31m%s\033[0m' "$out" | tail -n 3)"
  fi
}

# c: close the row's session, keeping the worktree.
close_session() { # PATH SID
  local path=$1 sid=${2:-}
  if [ -z "$sid" ]; then
    note "no session open in $(tilde "$path")"
    return
  fi
  local lines=("b:Close this session?" "-:" "-:$(tilde "$path")" "-:" "d:Its programs stop. The worktree stays." "-:")
  while IFS= read -r l; do lines+=("-:$l"); done < <(rex window ls -s "$sid" 2>/dev/null)
  lines+=("-:" "b:y close · any other key: cancel")
  local answer
  touch "$WT_UI_NOTE_FILE.busy"
  answer=$(confirm "${lines[@]}")
  rm -f "$WT_UI_NOTE_FILE.busy"
  if [ "$answer" = y ] || [ "$answer" = Y ]; then
    rex kill "$sid" >/dev/null 2>&1 && note "closed the session in $(tilde "$path")" || note "couldn't close it"
  else
    note "kept"
  fi
}

# p: the listed repos' worktrees that wt merged says can go (an empty one only
# when no session is in it), confirmed once, then removed with their sessions.
prune() { # [--dry-run: only print what it would prune]
  local dry=${1:-} data
  data=$(cached_list)
  local -a paths=() mains=() lines=()
  local main path branch reason has
  while IFS= read -r main; do
    while IFS=$'\t' read -r path branch reason; do
      [ -n "$path" ] || continue
      has=$(jq -r --arg p "$path" '[.repos[].worktrees[] | select(.path == $p)
        | (.sessions | if type == "array" then . else [] end) | length][0] // 0' <<<"$data")
      [ "$reason" = empty ] && [ "$has" -gt 0 ] && continue
      paths+=("$path") mains+=("$main")
      lines+=("-:  $branch  ($reason)$([ "$has" -gt 0 ] && echo ', its session closes')")
      lines+=("d:    $(tilde "$path")")
    done < <(cd "$main" && wt merged 2>/dev/null)
  done < <(jq -r '.repos[].main' <<<"$data")
  if [ "$dry" = --dry-run ]; then
    [ "${#paths[@]}" -gt 0 ] && printf '%s\n' "${paths[@]}"
    return
  fi
  if [ "${#paths[@]}" -eq 0 ]; then
    note "nothing to prune: no merged, gone or unused worktrees"
    return
  fi
  local answer
  touch "$WT_UI_NOTE_FILE.busy"
  answer=$(confirm "b:Prune ${#paths[@]} worktree(s)?" "-:" \
    "d:merged: its commits are all in the base branch" \
    "d:gone: its upstream branch was deleted" \
    "d:unused: no commits of its own" \
    "d:None has uncommitted changes. Branches stay." \
    "-:" "${lines[@]}" "-:" "b:y prune · any other key: cancel")
  rm -f "$WT_UI_NOTE_FILE.busy"
  if [ "$answer" != y ] && [ "$answer" != Y ]; then
    note "nothing pruned"
    return
  fi
  local i ok=0 failed=()
  for i in "${!paths[@]}"; do
    if (cd "${mains[$i]}" && wt rm "${paths[$i]}" >/dev/null 2>&1); then
      ok=$((ok + 1))
    else
      failed+=("$(basename "${paths[$i]}")")
    fi
  done
  if [ "${#failed[@]}" -eq 0 ]; then
    note "pruned $ok worktree(s)"
  else
    note "$(printf '\033[31mpruned %s; failed: %s\033[0m' "$ok" "${failed[*]}")"
  fi
}

# New worktree from the prompt's text (AGENT 0/1).
new_guard() { # AGENT QUERY MAIN
  if [ -z "$2" ]; then
    printf 'transform-header:%q header %q' "$SELF" "type the new branch name, then enter (esc: back)"
  else
    printf 'become:%q new %q %q %q' "$SELF" "$1" "$2" "${3:-}"
  fi
}

# Back to browsing: hide the prompt, letters are commands again.
browse() {
  printf 'clear-query+enable-search+hide-input+change-prompt(> )+rebind(%s)+transform-header(%q header)' \
    "$LETTERS" "$SELF"
}

# n / a: a prompt for the new branch, in the selected row's repo.
new_mode() { # AGENT MAIN
  local main=${2:-$(git rev-parse --show-toplevel 2>/dev/null)} what=new
  [ "$1" = 1 ] && what="new + claude"
  printf 'show-input+disable-search+clear-query+unbind(%s)+change-prompt(%s in %s> )' \
    "$LETTERS" "$what" "$(basename "${main:-?}")"
  printf '+transform-header:%q header %q' "$SELF" "↵ create · esc back"
}

# enter: create in a new-branch prompt; otherwise go to the row (with no row
# matching a search, create the query in the popup's repo).
enter() { # QUERY MAIN PATH SID [BLOCK]
  case "${FZF_PROMPT:-}" in
    "new + claude in "*) new_guard 1 "$1" "$2"; return ;;
    "new in "*) new_guard 0 "$1" "$2"; return ;;
  esac
  if [ -n "$3" ]; then
    printf 'become:%q go %q %q %q' "$SELF" "$3" "${4:-}" "${5:-}"
  elif [ -n "$1" ]; then
    new_guard 0 "$1" ""
  fi
}

# esc: leave a prompt, or close the popup when browsing.
escape() {
  if [ "${FZF_INPUT_STATE:-}" = hidden ]; then echo abort; else browse; fi
}

main() {
  export WT_UI_NOTE_FILE="${WT_UI_NOTE_FILE:-$(mktemp -t wt-ui)}"
  local s="$SELF"
  rm -f "$WT_UI_NOTE_FILE.sock"
  # exec: the popup's program is then fzf, not bash. Rex's sidebar ignores
  # titles that shells set ("Prefer generated titles"), so only a title set
  # while fzf runs is shown: set here, just after the exec (and on every
  # reopen after an error). The ticker cleans up.
  { sleep 0.3; printf '\033]2;Worktrees\007' >/dev/tty; } 2>/dev/null &
  exec fzf --ansi --no-sort --tiebreak=index --layout=reverse --no-input \
    --listen="$WT_UI_NOTE_FILE.sock" \
    --bind="start:execute-silent($s ticker >/dev/null 2>&1 &)" \
    --delimiter=$'\t' --with-nth=6.. --prompt='> ' \
    --header="$(header)" --header-first \
    --preview="$s preview {3} {4} {5}" --preview-window='right,45%,wrap' \
    --bind="j:down,k:up,q:abort" \
    --bind="esc:transform($s escape)" \
    --bind="enter:transform($s enter {q} {2} {3} {4} {5})" \
    --bind="/:show-input+unbind($LETTERS)+change-prompt(search> )+transform-header:$s header '↵ go · esc back'" \
    --bind="n:transform($s new-mode 0 {2})" \
    --bind="a:transform($s new-mode 1 {2})" \
    --bind="x:execute($s rm {1} {2} {3})+transform-header($s header)+reload($s rows)" \
    --bind="c:execute($s close {3} {4})+transform-header($s header)+reload($s rows)" \
    --bind="p:execute($s prune)+transform-header($s header)+reload($s rows)" \
    --bind="t:execute-silent($s toggle-agents)+reload($s rows)" \
    --bind="o:execute-silent($s toggle-all)+transform-header($s header)+reload($s rows)" \
    --bind="r:transform-header($s header)+reload($s rows)" \
    < <(rows) >/dev/null
}

case "${1:-}" in
  rows) rows ;;
  header) shift; header "$@" ;;
  preview) shift; preview "$@" ;;
  go) shift; go "$@" ;;
  new) shift; new "$@" ;;
  new-guard) shift; new_guard "$@" ;;
  enter) shift; enter "$@" ;;
  new-mode) shift; new_mode "$@" ;;
  escape) escape ;;
  rm) shift; rm_worktree "$@"; true ;;
  close) shift; close_session "$@"; true ;;
  prune) shift; prune "$@"; true ;;
  ticker) ticker ;;
  toggle-agents) toggle "$HIDE_AGENTS" ;;
  toggle-all) toggle "$SHOW_ALL" ;;
  "") main ;;
  *) echo "wt-ui: unknown command $1" >&2; exit 1 ;;
esac
